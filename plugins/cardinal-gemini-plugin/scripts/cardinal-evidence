#!/usr/bin/env python3
"""cardinal-evidence — cite any tool result from a Gemini CLI session in a
Cardinal storyboard (Gemini CLI adapter).

The plugin's hook keeps the result of every tool call Gemini CLI makes (shell
commands, file reads and edits, searches, web fetches, other MCP servers,
any tool) on this machine: ~/.cardinal/evidence/<session>/ev_<id>.json,
scrubbed, capped at 256 KiB, removed after 14 days. A call that touched
something sensitive is kept only as a *withheld* stub and cannot be cited.
Nothing is uploaded until you promote it.

Commands (cardinal_core.evidence_promote, shared by every adapter):
  promote --storyboard sb_... ev_... [ev_...]   upload as captured receipts
  list [--tool GLOB] [--grep TEXT] [--withheld]  this session's entries
  find TEXT                                     entries containing TEXT
  show ev_...                                   one entry as it would be cited
  off | on | status

promote uploads with the Cardinal MCP key `cardinal-connect` stored in
~/.gemini/cardinal-secrets.json, only to the origin of the connected MCP URL
(~/.gemini/cardinal.json mcp_url), never across a redirect.
"""

from __future__ import annotations

import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "hooks"))

from cardinal_core import evidence_promote  # noqa: E402
from cardinal_core.paths import AgentPaths  # noqa: E402

RUNTIME = "gemini"
SESSION_ENV = ('GEMINI_SESSION_ID',)


def adapter() -> "evidence_promote.PromoteAdapter":
    paths = AgentPaths(home=Path.home() / ".gemini")
    return evidence_promote.PromoteAdapter(
        runtime=RUNTIME,
        client=RUNTIME,
        connection=evidence_promote.agent_paths_connection(paths),
        session_env=SESSION_ENV,
        connect_hint="cardinal-connect",
        reconnect_hint="cardinal-connect --rotate",
        prog="cardinal-evidence",
    )


def main(argv=None) -> int:
    return evidence_promote.main(argv, adapter())


if __name__ == "__main__":
    sys.exit(main())
