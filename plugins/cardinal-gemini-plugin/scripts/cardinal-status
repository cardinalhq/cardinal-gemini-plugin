#!/usr/bin/env python3
"""Report Cardinal Gemini CLI connection status."""

from __future__ import annotations

import json
import re
import subprocess
import sys
import urllib.error
import urllib.request
from datetime import datetime, timezone
from pathlib import Path


GEMINI_DIR = Path.home() / ".gemini"
SETTINGS_PATH = GEMINI_DIR / "settings.json"
EXTENSION_DIR = GEMINI_DIR / "extensions" / "cardinal"
STATE_PATH = GEMINI_DIR / "cardinal.json"
SECRETS_PATH = GEMINI_DIR / "cardinal-secrets.json"
MCP_SERVER_NAME = "cardinal"
HOOK_MARKER = "cardinal-gemini-plugin"
# Gemini CLI reads hook `timeout` in milliseconds; plugin versions before
# 0.17 wrote 5, which kills every hook before it can answer.
MIN_HOOK_TIMEOUT_MS = 1000
# Hooks are on by default from Gemini CLI 0.26.0 (hooksConfig.enabled).
MIN_GEMINI_VERSION = (0, 26, 0)


def _cardinal_handlers(event_map: object):
    if not isinstance(event_map, dict):
        return
    for event, groups in event_map.items():
        if not isinstance(groups, list):
            continue
        for group in groups:
            handlers = group.get("hooks") if isinstance(group, dict) else None
            if not isinstance(handlers, list):
                continue
            for handler in handlers:
                if isinstance(handler, dict) and HOOK_MARKER in str(handler.get("command") or ""):
                    yield event, handler


def _short_timeout_events(event_map: object) -> list[str]:
    return sorted({
        event for event, handler in _cardinal_handlers(event_map)
        if isinstance(handler.get("timeout"), (int, float)) and handler["timeout"] < MIN_HOOK_TIMEOUT_MS
    })


def hook_registration_problems(settings: dict) -> list[str]:
    """Local-file checks for hook registrations that Gemini CLI silently
    ignores (no top-level `hooks` key) or kills (seconds-style timeouts)."""
    problems = []
    hooks_file = EXTENSION_DIR / "hooks" / "hooks.json"
    if hooks_file.exists():
        try:
            data = json.loads(hooks_file.read_text())
        except Exception:
            data = None
        if not isinstance(data, dict) or not isinstance(data.get("hooks"), dict):
            problems.append(f"{hooks_file} has no top-level \"hooks\" object, so Gemini CLI loads none of Cardinal's hooks.")
        else:
            short = _short_timeout_events(data["hooks"])
            if short:
                problems.append(f"{hooks_file} sets hook timeouts under {MIN_HOOK_TIMEOUT_MS}ms for {', '.join(short)}.")
    short = _short_timeout_events(settings.get("hooks"))
    if short:
        problems.append(f"{SETTINGS_PATH} sets Cardinal hook timeouts under {MIN_HOOK_TIMEOUT_MS}ms for {', '.join(short)}.")
    return problems


def hooks_disabled_reason(settings: dict) -> str | None:
    hooks_config = settings.get("hooksConfig")
    if isinstance(hooks_config, dict) and hooks_config.get("enabled") is False:
        return "hooksConfig.enabled is false in settings.json"
    return None


def gemini_version() -> tuple[int, int, int] | None:
    try:
        out = subprocess.run(["gemini", "--version"], capture_output=True, text=True, timeout=10)
    except (OSError, subprocess.TimeoutExpired):
        return None
    match = re.search(r"(\d+)\.(\d+)\.(\d+)", out.stdout or "")
    return (int(match[1]), int(match[2]), int(match[3])) if match else None


def load_json(path: Path, label: str) -> dict:
    if not path.exists():
        return {}
    try:
        data = json.loads(path.read_text())
    except Exception as exc:
        print(f"{label} ({path}) is unreadable: {exc}")
        sys.exit(1)
    if not isinstance(data, dict):
        print(f"{label} ({path}) is not a JSON object.")
        sys.exit(1)
    return data


def find_mcp_entry(settings: dict) -> dict:
    """Look in settings.json first, then the extension manifest."""
    servers = settings.get("mcpServers")
    if isinstance(servers, dict):
        entry = servers.get(MCP_SERVER_NAME)
        if isinstance(entry, dict):
            return entry
    ext_manifest = EXTENSION_DIR / "gemini-extension.json"
    if ext_manifest.exists():
        try:
            manifest = json.loads(ext_manifest.read_text())
        except Exception:
            return {}
        servers = manifest.get("mcpServers")
        if isinstance(servers, dict):
            entry = servers.get(MCP_SERVER_NAME)
            if isinstance(entry, dict):
                return entry
    return {}


def probe_mcp(mcp_url: str, api_key: str) -> str:
    req = urllib.request.Request(
        mcp_url,
        method="GET",
        headers={"x-cardinalhq-api-key": api_key},
    )
    try:
        with urllib.request.urlopen(req, timeout=10) as resp:
            return f"OK MCP reachable (HTTP {resp.status})"
    except urllib.error.HTTPError as exc:
        if exc.code in (401, 403):
            return f"FAIL MCP returned HTTP {exc.code}; run cardinal-connect --rotate."
        return f"OK MCP reachable (HTTP {exc.code}; auth accepted)"
    except (urllib.error.URLError, TimeoutError) as exc:
        return f"FAIL MCP network error: {exc}"


def probe_ingest(endpoint: str, api_key: str, api_header: str) -> str:
    req = urllib.request.Request(
        endpoint.rstrip("/") + "/v1/metrics",
        data=b"",
        method="POST",
        headers={
            "content-type": "application/x-protobuf",
            api_header: api_key,
        },
    )
    try:
        with urllib.request.urlopen(req, timeout=10) as resp:
            return f"OK ingest reachable (HTTP {resp.status})"
    except urllib.error.HTTPError as exc:
        if exc.code in (401, 403):
            return f"FAIL ingest returned HTTP {exc.code}; run cardinal-connect --rotate."
        if exc.code < 500:
            return f"OK ingest reachable (HTTP {exc.code}; auth accepted)"
        return f"FAIL ingest returned HTTP {exc.code}"
    except (urllib.error.URLError, TimeoutError) as exc:
        return f"FAIL ingest network error: {exc}"


def main() -> int:
    if not STATE_PATH.exists():
        print("Not connected. Run cardinal-connect to configure Cardinal for Gemini CLI.")
        return 1

    state = load_json(STATE_PATH, "cardinal.json")
    secrets = load_json(SECRETS_PATH, "cardinal-secrets.json")
    settings = load_json(SETTINGS_PATH, "settings.json")
    entry = find_mcp_entry(settings)

    print(f"Mode:         {state.get('mode', 'unknown')}")
    print(f"Install:      {state.get('install_shape', 'unknown')}")
    print(f"User:         {state.get('user_email')}")
    print(f"Org:          {state.get('org_slug') or state.get('org_id')}")
    print(f"Host:         {state.get('host')}")
    print(f"Plugin ver:   {state.get('plugin_version')}")

    written_at = state.get("written_at")
    if written_at:
        try:
            connected_at = datetime.fromisoformat(written_at.replace("Z", "+00:00"))
            age_days = (datetime.now(timezone.utc) - connected_at).days
            print(f"Connected:    {age_days} day(s) ago")
        except Exception:
            pass

    print()
    print(f"Telemetry:       {'enabled' if state.get('telemetry', {}).get('enabled') else 'disabled'}")
    print(f"Ingest endpoint: {state.get('ingest_endpoint')}")
    print(f"Ingest key pref: {state.get('ingest_key_prefix')}")
    print(f"Settings path:   {SETTINGS_PATH}")
    print(f"Extension dir:   {state.get('extension_dir') or '(not installed)'}")
    print(f"Secrets path:    {SECRETS_PATH}")
    print()
    print(f"MCP endpoint:    {state.get('mcp_url')}")
    print(f"MCP key prefix:  {state.get('mcp_key_prefix')}")

    failures = 0

    ingest_endpoint = state.get("ingest_endpoint")
    ingest_key = secrets.get("ingest_api_key")
    ingest_header = secrets.get("ingest_api_header") or "x-cardinalhq-api-key"
    if ingest_endpoint and ingest_key:
        msg = probe_ingest(str(ingest_endpoint), str(ingest_key), str(ingest_header))
        print(msg)
        if msg.startswith("FAIL"):
            failures += 1
    elif state.get("telemetry", {}).get("enabled"):
        print("FAIL Cardinal ingest endpoint or local ingest key is missing.")
        failures += 1

    if state.get("mcp_url"):
        if not entry:
            print("FAIL No cardinal MCP entry found in settings.json or extension manifest.")
            failures += 1
        else:
            config_url = entry.get("url")
            headers = entry.get("headers") or entry.get("http_headers")
            api_key = headers.get("X-CardinalHQ-API-Key") if isinstance(headers, dict) else None

            if config_url and config_url != state.get("mcp_url"):
                print(f"WARN Config URL differs from state: {config_url}")
            if not config_url or not api_key:
                print("FAIL Cardinal MCP URL or API key header is missing from Gemini config.")
                failures += 1
            else:
                msg = probe_mcp(str(config_url), str(api_key))
                print(msg)
                if msg.startswith("FAIL"):
                    failures += 1

    for problem in hook_registration_problems(settings):
        print(f"FAIL {problem} Re-run cardinal-connect to rewrite it, then restart Gemini CLI.")
        failures += 1
    disabled = hooks_disabled_reason(settings)
    if disabled:
        print(f"WARN Gemini CLI hooks are disabled ({disabled}); Cardinal hook telemetry will not run.")
    version = gemini_version()
    if version and version < MIN_GEMINI_VERSION:
        print(
            f"WARN Gemini CLI {'.'.join(map(str, version))} predates 0.26.0, where hooks are on by default. "
            "Upgrade, or enable hooks in ~/.gemini/settings.json: "
            "\"hooks\": {\"enabled\": true} on 0.24-0.25, \"tools\": {\"enableHooks\": true} on 0.21-0.23."
        )

    print()
    print("Restart Gemini CLI if you connected or disconnected in the current process.")
    return 1 if failures else 0


if __name__ == "__main__":
    sys.exit(main())
