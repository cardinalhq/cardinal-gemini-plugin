#!/usr/bin/env python3
"""Launch the cardinal-behavior MCP server for Gemini CLI, from an installed Cardinal
plugin (lib/behavior) or a source checkout (common/behavior).

cardinal-connect registers this file as the `cardinal-behavior` MCP server
with `--runtime gemini`, which selects this runtime's connection
(~/.gemini/cardinal.json + cardinal-secrets.json; CARDINAL_MCP_URL /
CARDINAL_MCP_API_KEY in the environment override them), its Checks ledger and
how a range run is followed (the get_behavior_range tool). The runtime is
added here too when the registration lacks it.
"""
from pathlib import Path
import runpy
import sys

RUNTIME = 'gemini'
launcher = Path(__file__).resolve()
behavior = launcher.parents[1] / 'lib' / 'behavior'
if not (behavior / 'server.py').exists():
    behavior = launcher.parents[3] / 'common' / 'behavior'
if not (behavior / 'server.py').exists():
    raise SystemExit('Cardinal behavior runtime is missing; reinstall the plugin.')
if not any(arg == '--runtime' or arg.startswith('--runtime=') for arg in sys.argv[1:]):
    sys.argv[1:1] = ['--runtime', RUNTIME]
sys.path.insert(0, str(behavior))
runpy.run_path(str(behavior / 'server.py'), run_name='__main__')
