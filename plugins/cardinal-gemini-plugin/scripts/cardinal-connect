#!/usr/bin/env python3
"""Connect Gemini CLI to Cardinal telemetry and MCP.

Runs Cardinal's device-code flow, mints ingest and MCP keys, verifies both
endpoints, and writes a managed Cardinal extension bundle under
~/.gemini/extensions/cardinal/ (GEMINI.md, the manifest with mcpServers
merged, hooks, skills, agents). Cardinal's hooks send Cardinal's events.

Gemini CLI's own OTLP exporter is opt-in (--native-telemetry): it adds a
schema-valid `telemetry` block to ~/.gemini/settings.json and the ingest
key header to ~/.gemini/.env (Gemini reads OTLP headers only from
OTEL_EXPORTER_OTLP_HEADERS). settings.json never carries a key, and no
Cardinal marker: Gemini validates `telemetry` and `mcpServers` entries
strictly, so what Cardinal wrote is recorded in ~/.gemini/cardinal.json
(`settings_owned`). A re-run (or --repair) rewrites the invalid
`telemetry` block plugin 0.22.1 and earlier wrote (target "otlp",
otlpHeaders, cardinalManaged), which stops Gemini CLI from starting.

Monorepo adapter: the device-code flow, endpoint reachability probes, and
atomic file writers come from the vendored `cardinal_core` package. This
script keeps only Gemini-specific install logic — the extension bundle
and the settings.json writer.
"""

from __future__ import annotations

import argparse
import json
import os
import re
import shlex
import shutil
import sys
import time
import urllib.parse
from datetime import datetime, timezone
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "hooks"))
from cardinal_core import deviceflow, tls  # noqa: E402
from cardinal_core.paths import (  # noqa: E402
    AgentPaths,
    atomic_write,
    atomic_write_secret,
    backup,
)


def _load_plugin_version() -> str:
    manifest = Path(__file__).resolve().parent.parent / ".gemini-plugin" / "plugin.json"
    try:
        return json.loads(manifest.read_text(encoding="utf-8")).get("version") or "unknown"
    except (OSError, ValueError):
        return "unknown"


PLUGIN_VERSION = _load_plugin_version()
CLIENT_ID = "cardinal-gemini-plugin"
MCP_SERVER_NAME = "cardinal"
EXTENSION_NAME = "cardinal"

PLUGIN_ROOT = Path(__file__).resolve().parent.parent
HOOK_SCRIPT = PLUGIN_ROOT / "hooks" / "cardinal-gemini-telemetry.py"
EXTENSION_SOURCE = PLUGIN_ROOT / "extension"

GEMINI_DIR = Path.home() / ".gemini"
PATHS = AgentPaths(home=GEMINI_DIR)
SETTINGS_PATH = GEMINI_DIR / "settings.json"
EXTENSIONS_DIR = GEMINI_DIR / "extensions"
EXTENSION_INSTALL_DIR = EXTENSIONS_DIR / EXTENSION_NAME
STATE_PATH = PATHS.state_path
SECRETS_PATH = PATHS.secrets_path
PENDING_PATH = PATHS.pending_path

HOOK_MARKER = "cardinal-gemini-plugin"
# Gemini CLI reads hook `timeout` in MILLISECONDS and, on expiry, kills the
# hook and drops its output (packages/core/src/hooks/hookRunner.ts). Hooks
# do only local work synchronously (network runs in a detached child, or
# under a hard deadline: SessionStart's bootstrap + limits fetch + discovery,
# AfterAgent's turn-end check and owner-input flush); 10 s covers them.
HOOK_TIMEOUT_MS = 10000
# The storyboard preview renders every scene in the user's Chromium
# (storyboard_authoring.on_preview: PREVIEW_HOOK_TIMEOUT_S).
PREVIEW_TIMEOUT_MS = 150000
# Every Cardinal hook group: (event, matcher, role, timeout ms). A matcher
# is a regex Gemini searches in the tool name ("" = every call). Gemini
# dedupes an event's hooks by `name:command` (gemini-cli 0.50.0
# getHookKey, chunk-W4YMYD53.js:324365, and HookPlanner.deduplicateHooks),
# so a second group on the same event needs its own command: the role.
#   BeforeTool       context stamping on Cardinal's storyboard tools
#   BeforeTool       role checks-gate: denies activate_skill for the checks
#                    skill while the Checks preview is off (matcher: the
#                    built-in tool's exact name)
#   AfterTool        telemetry, evidence, advisories, authoring (every call)
#   AfterTool        role preview: the storyboard__preview render (slow)
#   AfterAgent       the turn's end: flush and stage only, never a block
HOOK_GROUPS = (
    ("SessionStart", "", "", HOOK_TIMEOUT_MS),
    ("BeforeAgent", "", "", HOOK_TIMEOUT_MS),
    ("BeforeTool", "storyboard__(create|add_act|publish|find)$", "", HOOK_TIMEOUT_MS),
    ("BeforeTool", "^activate_skill$", "checks-gate", HOOK_TIMEOUT_MS),
    ("AfterModel", "", "", HOOK_TIMEOUT_MS),
    ("AfterTool", "", "", HOOK_TIMEOUT_MS),
    ("AfterTool", "storyboard__preview$", "preview", PREVIEW_TIMEOUT_MS),
    ("AfterAgent", "", "", HOOK_TIMEOUT_MS),
    ("PreCompress", "", "", HOOK_TIMEOUT_MS),
    ("SessionEnd", "", "", HOOK_TIMEOUT_MS),
)
REGISTERED_EVENTS = tuple(dict.fromkeys(event for event, _, _, _ in HOOK_GROUPS))
# Written into the installed extension's SKILL.md files: the plugin's
# absolute root, so a skill names this plugin's scripts/ wherever Gemini runs.
PLUGIN_ROOT_PLACEHOLDER = "__CARDINAL_PLUGIN_ROOT__"


def hook_command(script: str, event: str, role: str = "") -> str:
    """The command of one Cardinal hook handler (the marker lets
    cardinal-disconnect and the repair find it)."""
    role_arg = f" --role {shlex.quote(role)}" if role else ""
    return f"python3 {script} --event {shlex.quote(event)}{role_arg} # {HOOK_MARKER}"


def _is_cardinal_group(group: object) -> bool:
    if not isinstance(group, dict):
        return False
    if group.get("cardinalManaged"):
        return True
    handlers = group.get("hooks")
    return isinstance(handlers, list) and any(
        isinstance(h, dict) and HOOK_MARKER in str(h.get("command") or "") for h in handlers
    )


def _cardinal_signature(hooks_root: object) -> list:
    if not isinstance(hooks_root, dict):
        return []
    return sorted(
        (event, str(g.get("matcher") or ""), str(h.get("command")), h.get("timeout"))
        for event, groups in hooks_root.items() if isinstance(groups, list)
        for g in groups if _is_cardinal_group(g)
        for h in g.get("hooks") or [] if isinstance(h, dict)
    )


def set_cardinal_hook_entries(hooks_root: object) -> dict:
    """settings.json `hooks` with every Cardinal group removed (any event,
    including retired registrations such as AfterAgent) and the current
    registrations appended. Non-Cardinal entries are left untouched."""
    root = dict(hooks_root) if isinstance(hooks_root, dict) else {}
    for event, groups in list(root.items()):
        if not isinstance(groups, list):
            continue
        kept = [g for g in groups if not _is_cardinal_group(g)]
        if kept:
            root[event] = kept
        else:
            root.pop(event)
    for event, matcher, role, timeout in HOOK_GROUPS:
        groups = root.get(event) if isinstance(root.get(event), list) else []
        # No `cardinalManaged` key: the command's HOOK_MARKER identifies
        # Cardinal's groups (older groups carrying the key still match).
        groups.append({
            "matcher": matcher,
            "hooks": [{
                "type": "command",
                "command": hook_command(shlex.quote(str(HOOK_SCRIPT)), event, role),
                "timeout": timeout,
            }],
        })
        root[event] = groups
    return root


def render_extension_hooks() -> str:
    """extension/hooks/hooks.json with `__HOOK_SCRIPT__` patched to this
    plugin's absolute telemetry hook path."""
    hooks_src = (EXTENSION_SOURCE / "hooks" / "hooks.json").read_text()
    return hooks_src.replace("__HOOK_SCRIPT__", shlex.quote(str(HOOK_SCRIPT)).strip("'"))


def write_extension_hooks(target_dir: Path) -> None:
    (target_dir / "hooks").mkdir(parents=True, exist_ok=True)
    (target_dir / "hooks" / "hooks.json").write_text(render_extension_hooks())


def repair_hook_registration() -> list[str]:
    """Rewrite existing Cardinal hook registrations in place, without new
    credentials. Installs from plugin versions before 0.17 wrote a
    hooks.json that Gemini CLI rejects (no top-level `hooks` key) and
    seconds-style timeouts (5 = 5ms); re-running cardinal-connect fixes
    both. A Cardinal-managed extension is rebuilt from this plugin (hooks,
    skills, agents, GEMINI.md, the manifest with its mcpServers kept, plus
    `cardinal-behavior` next to a concrete `cardinal`) when any of it
    differs, so an upgraded plugin's skills, hooks and MCP servers reach
    Gemini; without the extension, settings.json gets the same hooks and
    `cardinal-behavior` entry. Returns the paths rewritten."""
    repaired: list[str] = []
    manifest = read_manifest(EXTENSION_INSTALL_DIR)
    if manifest is not None and manifest.get("cardinalManaged"):
        url, key = cardinal_server(manifest)
        if refresh_extension_bundle(url, key):
            repaired.append(str(EXTENSION_INSTALL_DIR))
    if SETTINGS_PATH.exists():
        settings = load_json_object(SETTINGS_PATH, "settings.json")
        before = json.loads(json.dumps(settings))
        changed = False
        hooks_root = settings.get("hooks")
        signature = _cardinal_signature(hooks_root)
        if signature:
            updated = set_cardinal_hook_entries(hooks_root)
            if _cardinal_signature(updated) != signature:
                settings["hooks"] = updated
                changed = True
        # A --no-extension connection made before the Checks preview: its
        # managed `cardinal` server has no `cardinal-behavior` next to it.
        owned = owned_servers_record(read_state())
        servers = settings.get("mcpServers")
        cardinal = servers.get(MCP_SERVER_NAME) if isinstance(servers, dict) else None
        if owns_server(MCP_SERVER_NAME, cardinal, owned):
            current = servers.get(BEHAVIOR_SERVER_NAME)
            wanted = behavior_server()
            if (not isinstance(current, dict) or owns_server(BEHAVIOR_SERVER_NAME, current, owned)) \
                    and current != wanted:
                servers[BEHAVIOR_SERVER_NAME] = wanted
                changed = True
        if changed:
            write_settings(before, settings)
            repaired.append(str(SETTINGS_PATH))
            if isinstance(servers, dict) and servers.get(BEHAVIOR_SERVER_NAME) == behavior_server():
                remember_owned_servers({BEHAVIOR_SERVER_NAME: server_fingerprint(
                    BEHAVIOR_SERVER_NAME, servers[BEHAVIOR_SERVER_NAME])})
    return repaired


def write_pending(grant: dict) -> None:
    payload = {
        "verification_uri": grant.get("verification_uri", ""),
        "user_code": grant.get("user_code", ""),
        "expires_in": grant.get("expires_in", deviceflow.DEFAULT_POLL_TIMEOUT_SECS),
        "written_at": datetime.now(timezone.utc).isoformat(),
        "plugin_version": PLUGIN_VERSION,
    }
    atomic_write(PENDING_PATH, json.dumps(payload, indent=2) + "\n")


def clear_pending() -> None:
    try:
        PENDING_PATH.unlink()
    except FileNotFoundError:
        pass


def load_json_object(path: Path, label: str) -> dict:
    if not path.exists():
        return {}
    try:
        data = json.loads(path.read_text())
    except json.JSONDecodeError as exc:
        sys.exit(f"Refusing to write: {label} ({path}) is not valid JSON ({exc}).")
    if not isinstance(data, dict):
        sys.exit(f"Refusing to write: {label} ({path}) is not a JSON object.")
    return data


# ---------------------------------------------------------------------------
# Extension bundle install
# ---------------------------------------------------------------------------

SKILLS_SOURCE = PLUGIN_ROOT / "skills"
AGENTS_SOURCE = PLUGIN_ROOT / "agents"
_COPY_IGNORE = shutil.ignore_patterns("__pycache__", "*.pyc", ".DS_Store")


def read_manifest(ext_dir: Path) -> dict | None:
    """The extension's gemini-extension.json as an object, else None."""
    try:
        data = json.loads((ext_dir / "gemini-extension.json").read_text())
    except (OSError, ValueError):
        return None
    return data if isinstance(data, dict) else None


def cardinal_server(manifest: dict | None) -> tuple:
    """(url, key) of the manifest's concrete mcpServers.cardinal, else
    (None, None) (absent, or still a `${VAR}` placeholder)."""
    servers = manifest.get("mcpServers") if isinstance(manifest, dict) else None
    entry = servers.get(MCP_SERVER_NAME) if isinstance(servers, dict) else None
    if not isinstance(entry, dict):
        return None, None
    url = entry.get("url")
    headers = entry.get("headers")
    key = headers.get("X-CardinalHQ-API-Key") if isinstance(headers, dict) else None
    if not (isinstance(url, str) and url and "${" not in url
            and isinstance(key, str) and key and "${" not in key):
        return None, None
    return url, key


# The local cardinal-behavior MCP server (Checks preview, behavior tools): a
# stdio server Gemini CLI runs outside its sandbox, with --runtime gemini (its
# connection is ~/.gemini/cardinal.json + cardinal-secrets.json; no key here).
BEHAVIOR_SERVER_NAME = "cardinal-behavior"
BEHAVIOR_SCRIPT = PLUGIN_ROOT / "scripts" / "cardinal-behavior"
MANAGED_SERVERS = (MCP_SERVER_NAME, BEHAVIOR_SERVER_NAME)


def behavior_server() -> dict:
    return {"command": "python3", "args": [str(BEHAVIOR_SCRIPT), "--runtime", "gemini"]}


def merged_mcp_servers(installed: object, mcp_url: str | None, mcp_key: str | None) -> dict:
    """mcpServers for the installed manifest: every server already installed
    (a user's, or one a later Cardinal feature added) and every server this
    plugin's source manifest ships, MERGED, never replaced; then Cardinal's
    own entries: `cardinal` with concrete values (no `${VAR}` placeholders —
    Gemini's manifest variable substitution is unstable across releases) and
    `cardinal-behavior`, or neither when there is no MCP credential."""
    source = json.loads((EXTENSION_SOURCE / "gemini-extension.json").read_text()).get("mcpServers")
    servers: dict = {}
    for group in (installed, source):
        if isinstance(group, dict):
            servers.update({k: v for k, v in group.items() if k not in MANAGED_SERVERS})
    if mcp_url and mcp_key:
        servers[MCP_SERVER_NAME] = {"url": mcp_url, "headers": {"X-CardinalHQ-API-Key": mcp_key}}
        servers[BEHAVIOR_SERVER_NAME] = behavior_server()
    return servers


def copy_skills(target: Path) -> None:
    """skills/ into the extension (Gemini 0.50 loads <ext>/skills/*/SKILL.md,
    ExtensionManager.loadExtension), with each Markdown file's
    __CARDINAL_PLUGIN_ROOT__ replaced by this plugin's absolute root."""
    if not SKILLS_SOURCE.is_dir():
        return
    dest = target / "skills"
    shutil.copytree(SKILLS_SOURCE, dest, ignore=_COPY_IGNORE)
    for md in dest.rglob("*.md"):
        text = md.read_text(encoding="utf-8")
        if PLUGIN_ROOT_PLACEHOLDER in text:
            md.write_text(text.replace(PLUGIN_ROOT_PLACEHOLDER, str(PLUGIN_ROOT)), encoding="utf-8")


def copy_agents(target: Path) -> None:
    """agents/*.md into the extension (Gemini 0.50 loads <ext>/agents/*.md
    as local subagents, loadAgentsFromDirectory)."""
    if AGENTS_SOURCE.is_dir():
        shutil.copytree(AGENTS_SOURCE, target / "agents", ignore=_COPY_IGNORE)


def build_extension_bundle(target: Path, mcp_url: str | None, mcp_key: str | None,
                           installed_servers: object = None) -> None:
    """Write the whole extension into `target` (a new directory)."""
    target.mkdir(parents=True)
    shutil.copy(EXTENSION_SOURCE / "GEMINI.md", target / "GEMINI.md")
    manifest = json.loads((EXTENSION_SOURCE / "gemini-extension.json").read_text())
    servers = merged_mcp_servers(installed_servers, mcp_url, mcp_key)
    if servers:
        manifest["mcpServers"] = servers
    else:
        manifest.pop("mcpServers", None)
    manifest["cardinalManaged"] = True
    (target / "gemini-extension.json").write_text(json.dumps(manifest, indent=2) + "\n")
    write_extension_hooks(target)
    copy_skills(target)
    install_checks_skill(target)
    copy_agents(target)


def install_checks_skill(target: Path) -> None:
    """The Checks preview's skill, when `cardinal-checks on` (a rebuilt
    extension keeps it; SessionStart reconciles it otherwise)."""
    try:
        from cardinal_core import checks_install
        if checks_install.is_enabled("gemini"):
            checks_install.install(PLUGIN_ROOT, target / "skills" / checks_install.SKILL_DIR)
    except (OSError, ValueError):
        pass


def _tree(root: Path) -> dict:
    if not root.is_dir():
        return {}
    return {str(p.relative_to(root)): p.read_bytes() for p in sorted(root.rglob("*")) if p.is_file()}


# The extension is built OUTSIDE ~/.gemini/extensions/: Gemini CLI loads
# every subdirectory there as an extension, and a staging copy (same name
# "cardinal") makes it throw on the duplicate. ~/.gemini/cardinal/ is on the
# same filesystem, so the finished copy is renamed into place.
STAGING_PARENT = PATHS.runtime_dir
STAGING_PREFIX = ".extension-staging-"
OLD_STAGING_GLOB = f".{EXTENSION_NAME}.staging-*"   # before: inside extensions/


def _pid_alive(pid: int) -> bool:
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except OSError:
        return True   # exists, another user's
    return True


def _clean_stale_staging() -> None:
    """Remove what an interrupted connect left: old-style staging copies in
    ~/.gemini/extensions/ (which Gemini CLI loads as duplicate extensions),
    and staging copies under ~/.gemini/cardinal/ whose process is gone."""
    try:
        for p in EXTENSIONS_DIR.glob(OLD_STAGING_GLOB):
            if p.is_dir() and not p.is_symlink():
                shutil.rmtree(p, ignore_errors=True)
    except OSError:
        pass
    try:
        for p in STAGING_PARENT.glob(STAGING_PREFIX + "*"):
            suffix = p.name[len(STAGING_PREFIX):]
            if suffix.isdigit() and int(suffix) != os.getpid() and _pid_alive(int(suffix)):
                continue
            if p.is_dir() and not p.is_symlink():
                shutil.rmtree(p, ignore_errors=True)
    except OSError:
        pass


def _staging_dir() -> Path:
    _clean_stale_staging()
    STAGING_PARENT.mkdir(parents=True, exist_ok=True, mode=0o700)
    staging = STAGING_PARENT / f"{STAGING_PREFIX}{os.getpid()}"
    if staging.exists():
        shutil.rmtree(staging)
    EXTENSIONS_DIR.mkdir(parents=True, exist_ok=True)
    return staging


def _swap_in(staging: Path) -> None:
    if EXTENSION_INSTALL_DIR.exists():
        shutil.rmtree(EXTENSION_INSTALL_DIR)
    # A rename (same filesystem); shutil.move copies if ~/.gemini/cardinal
    # was linked elsewhere.
    shutil.move(str(staging), str(EXTENSION_INSTALL_DIR))


def install_extension_bundle(mcp_url: str | None, mcp_key: str | None) -> None:
    """Install this plugin's extension as ~/.gemini/extensions/cardinal/:
    GEMINI.md, the manifest (mcpServers merged: merged_mcp_servers),
    hooks/hooks.json (`__HOOK_SCRIPT__` replaced with the absolute path to
    this plugin's telemetry hook), skills/ and agents/. Built under
    ~/.gemini/cardinal/ (never inside extensions/, which Gemini CLI loads
    whole), then renamed into place."""
    staging = _staging_dir()
    try:
        build_extension_bundle(staging, mcp_url, mcp_key,
                               (read_manifest(EXTENSION_INSTALL_DIR) or {}).get("mcpServers"))
        _swap_in(staging)
    finally:
        if staging.exists():
            shutil.rmtree(staging, ignore_errors=True)


def refresh_extension_bundle(mcp_url: str | None, mcp_key: str | None) -> bool:
    """Rebuild the installed extension from this plugin when anything in it
    differs (credentials unchanged: the caller passes the installed ones).
    Whether it was rewritten."""
    staging = _staging_dir()
    try:
        build_extension_bundle(staging, mcp_url, mcp_key,
                               (read_manifest(EXTENSION_INSTALL_DIR) or {}).get("mcpServers"))
        if _tree(staging) == _tree(EXTENSION_INSTALL_DIR):
            return False
        _swap_in(staging)
        return True
    finally:
        if staging.exists():
            shutil.rmtree(staging, ignore_errors=True)


# ---------------------------------------------------------------------------
# settings.json — (opt-in) telemetry + (fallback) mcpServers + hooks
# ---------------------------------------------------------------------------
#
# Gemini CLI validates ~/.gemini/settings.json against its settings schema
# (gemini-cli 0.63.0 settingsSchema TelemetrySettings / MCPServerConfig,
# settings-validation buildZodSchemaFromJsonSchema): `telemetry` and every
# `mcpServers` entry reject unknown keys (additionalProperties: false), so a
# `cardinalManaged` or `otlpHeaders` key is reported on every start; hook
# groups are open objects. resolveTelemetrySettings (core telemetry/config)
# throws a FatalConfigError for any `target` but "local" / "gcp", and Gemini
# CLI refuses to start (0.26.0 through 0.63.0). Plugin 0.22.1 and earlier
# wrote target "otlp" + otlpHeaders (the ingest key) + cardinalManaged.
# Nothing Cardinal writes into settings.json carries a key or a marker:
# ownership lives in cardinal.json `settings_owned`.

_TELEMETRY_KEY = "telemetry"
# TelemetrySettings properties (gemini-cli 0.63.0).
TELEMETRY_KEYS = ("enabled", "target", "otlpEndpoint", "otlpProtocol", "traces",
                  "logPrompts", "outfile", "useCollector", "useCliAuth")
TELEMETRY_TARGETS = ("local", "gcp")
# From 0.34.0 Gemini CLI appends v1/traces, v1/logs and v1/metrics to an
# http otlpEndpoint (core telemetry/sdk buildUrl); before, every signal went
# to the endpoint as written, so an older CLI is pointed at /v1/logs.
OTLP_PATHS_APPENDED_FROM = (0, 34, 0)

# Gemini CLI takes OTLP headers only from the environment (the OTel
# exporters read OTEL_EXPORTER_OTLP_HEADERS; no settings key exists). It
# loads ONE .env per start: walking up from the working directory,
# <dir>/.gemini/.env (trusted folders only), then <dir>/.env; past the
# filesystem root ~/.gemini/.env (trusted only), then ~/.env (cli
# config/settings findEnvFile). An untrusted folder applies only auth
# variables. A variable already in the environment wins.
ENV_PATH = GEMINI_DIR / ".env"
HEADERS_ENV = "OTEL_EXPORTER_OTLP_HEADERS"
ENV_BLOCK_BEGIN = (f"# >>> {HOOK_MARKER}: Gemini CLI's OTLP exporter -> Cardinal ingest "
                   "(cardinal-connect writes it, cardinal-disconnect removes it)")
ENV_BLOCK_END = f"# <<< {HOOK_MARKER}"
_ENV_BLOCK_PREFIX = f"# >>> {HOOK_MARKER}"


def gemini_cli_version() -> tuple[int, int, int] | None:
    """The installed Gemini CLI's version, from the package.json of the
    `gemini` on PATH (file reads only). None when it cannot be found."""
    exe = shutil.which("gemini")
    if not exe:
        return None
    try:
        d = Path(os.path.realpath(exe)).parent
        for _ in range(6):
            pkg = d / "package.json"
            if pkg.is_file():
                data = json.loads(pkg.read_text(encoding="utf-8"))
                if isinstance(data, dict) and data.get("name") == "@google/gemini-cli":
                    m = re.match(r"(\d+)\.(\d+)\.(\d+)", str(data.get("version") or ""))
                    return (int(m[1]), int(m[2]), int(m[3])) if m else None
            if d.parent == d:
                break
            d = d.parent
    except (OSError, ValueError):
        pass
    return None


def native_telemetry_block(ingest_endpoint: str, version: tuple | None = None) -> dict:
    """The `telemetry` block for Gemini's own exporter: target "local" with an
    otlpEndpoint exports in process over OTLP/http (`useOtlp`, core
    telemetry/sdk initializeTelemetry). No key: headers come from the env."""
    endpoint = str(ingest_endpoint).rstrip("/")
    if version is not None and version < OTLP_PATHS_APPENDED_FROM:
        endpoint += "/v1/logs"
    return {
        "enabled": True,
        "target": "local",
        "otlpEndpoint": endpoint,
        "otlpProtocol": "http",
        "logPrompts": False,
    }


def is_legacy_telemetry(block: object) -> bool:
    """The invalid block plugin 0.22.1 and earlier wrote (or a copy of it)."""
    return isinstance(block, dict) and (
        bool(block.get("cardinalManaged")) or "otlpHeaders" in block or block.get("target") == "otlp"
    )


def sanitized_telemetry(block: dict) -> dict:
    """A legacy-shaped block that is not Cardinal's, made valid: schema keys
    only (otlpHeaders, which may hold a key, is dropped), target local/gcp."""
    clean = {k: v for k, v in block.items() if k in TELEMETRY_KEYS}
    if "target" in clean and clean["target"] not in TELEMETRY_TARGETS:
        clean["target"] = "local"
    if "otlpProtocol" in clean and clean["otlpProtocol"] not in ("grpc", "http"):
        clean.pop("otlpProtocol")
    return clean


def read_state() -> dict:
    try:
        data = json.loads(STATE_PATH.read_text())
    except (OSError, ValueError):
        return {}
    return data if isinstance(data, dict) else {}


def settings_owned_record(state: dict) -> dict:
    record = state.get("settings_owned")
    return record if isinstance(record, dict) else {}


def owned_servers_record(state: dict) -> dict:
    servers = settings_owned_record(state).get("mcp_servers")
    return servers if isinstance(servers, dict) else {}


def server_fingerprint(name: str, entry: dict) -> dict:
    """What identifies Cardinal's settings.json server entry (never its key)."""
    if name == MCP_SERVER_NAME:
        return {"url": entry.get("url")}
    return {"command": entry.get("command"), "args": entry.get("args")}


def owns_server(name: str, entry: object, owned: dict) -> bool:
    """Whether a settings.json mcpServers entry is Cardinal's: recorded in
    cardinal.json, or carrying the `cardinalManaged` key older versions wrote."""
    if not isinstance(entry, dict):
        return False
    if entry.get("cardinalManaged"):
        return True
    fingerprint = owned.get(name)
    return isinstance(fingerprint, dict) and bool(fingerprint) and all(
        entry.get(k) == v for k, v in fingerprint.items()
    )


def remember_owned_servers(update: dict) -> None:
    """Merge server fingerprints into cardinal.json `settings_owned`."""
    if not STATE_PATH.exists() or not update:
        return
    state = read_state()
    record = dict(settings_owned_record(state))
    record["mcp_servers"] = {**owned_servers_record(state), **update}
    state["settings_owned"] = record
    atomic_write(STATE_PATH, json.dumps(state, indent=2) + "\n")


def strip_env_block(text: str) -> str:
    """`text` without Cardinal's ~/.gemini/.env block."""
    lines = text.splitlines(keepends=True)
    if not any(line.startswith(_ENV_BLOCK_PREFIX) for line in lines):
        return text
    out: list[str] = []
    inside = False
    for line in lines:
        if not inside and line.startswith(_ENV_BLOCK_PREFIX):
            inside = True
            continue
        if inside:
            if line.strip() == ENV_BLOCK_END:
                inside = False
                continue
            if line.startswith(f"{HEADERS_ENV}="):
                continue
            # An unterminated block ends at its own lines.
            inside = False
        out.append(line)
    return "".join(out)


def env_assigns(text: str, name: str) -> bool:
    return bool(re.search(rf"^\s*(?:export\s+)?{re.escape(name)}\s*=", text, re.M))


def read_env_file() -> str:
    try:
        return ENV_PATH.read_text(encoding="utf-8")
    except FileNotFoundError:
        return ""


def apply_env_headers(header: str | None, key: str | None) -> bool:
    """Write Cardinal's block (the ingest key header for Gemini's exporter)
    into ~/.gemini/.env when `header` and `key` are given, else remove it.
    The file is 0600. Whether it changed."""
    text = read_env_file()
    new = strip_env_block(text)
    if header and key:
        if new and not new.endswith("\n"):
            new += "\n"
        value = f"{header}={urllib.parse.quote(key, safe='')}"
        new += f"{ENV_BLOCK_BEGIN}\n{HEADERS_ENV}='{value}'\n{ENV_BLOCK_END}\n"
    if new == text:
        return False
    if new.strip():
        atomic_write_secret(ENV_PATH, new)
    elif ENV_PATH.exists():
        ENV_PATH.unlink()
    return True


def _redacted(settings: dict) -> dict:
    """settings.json with legacy otlpHeaders values blanked (for backups)."""
    tel = settings.get(_TELEMETRY_KEY)
    if not (isinstance(tel, dict) and isinstance(tel.get("otlpHeaders"), dict)):
        return settings
    headers = {k: "<redacted by cardinal-connect>" for k in tel["otlpHeaders"]}
    return {**settings, _TELEMETRY_KEY: {**tel, "otlpHeaders": headers}}


def write_settings(before: dict, after: dict) -> Path | None:
    """Back up settings.json (an ingest key in a legacy block blanked), then
    write `after`. The backup path."""
    backup_path = None
    if SETTINGS_PATH.exists():
        redacted = _redacted(before)
        if redacted is before:
            backup_path = backup(SETTINGS_PATH)
        else:
            backup_path = SETTINGS_PATH.with_name(
                f"{SETTINGS_PATH.name}.bak.{time.strftime('%Y%m%d-%H%M%S')}")
            atomic_write_secret(backup_path, json.dumps(redacted, indent=2) + "\n")
    atomic_write(SETTINGS_PATH, json.dumps(after, indent=2) + "\n")
    return backup_path


def redact_legacy_backups() -> list[str]:
    """settings.json.bak.* files earlier connects wrote hold the ingest key
    in plain text (otlpHeaders); blank it. The paths rewritten."""
    rewritten = []
    for path in sorted(GEMINI_DIR.glob("settings.json.bak.*")):
        try:
            data = json.loads(path.read_text())
        except (OSError, ValueError):
            continue
        if not isinstance(data, dict):
            continue
        clean = _redacted(data)
        tel = data.get(_TELEMETRY_KEY)
        if clean is not data and tel.get("otlpHeaders") != clean[_TELEMETRY_KEY]["otlpHeaders"]:
            atomic_write_secret(path, json.dumps(clean, indent=2) + "\n")
            rewritten.append(str(path))
    return rewritten


def apply_settings(ingest: dict | None, mcp_url: str | None, mcp_key: str | None,
                   include_hooks: bool, native: bool = False) -> dict:
    """Bring ~/.gemini/settings.json (and ~/.gemini/.env) to what Cardinal
    wants, touching only what Cardinal owns. Returns {changed: [paths],
    backup, settings_owned, native_active, notes}.

    `telemetry` (only with `native` and an ingest credential): the block for
    Gemini's own OTLP exporter, plus Cardinal's ~/.gemini/.env block with
    the key header. Otherwise a Cardinal-owned block (recorded in
    cardinal.json, or the legacy `cardinalManaged` one) is removed and the
    .env block with it. A user's block is never replaced; one in the
    legacy shape (target "otlp" / otlpHeaders) is made valid, since Gemini
    CLI does not start with it.

    `mcpServers`: the `cardinalManaged` key older versions put on
    Cardinal's entries is removed (Gemini rejects it). When
    `include_hooks=True` (the no-extension install): `mcpServers.cardinal`
    and `cardinal-behavior`, and the hook groups (set_cardinal_hook_entries).
    """
    before = load_json_object(SETTINGS_PATH, "settings.json")
    settings = json.loads(json.dumps(before))
    state = read_state()
    prior = settings_owned_record(state)
    prior_servers = owned_servers_record(state)
    notes: list[str] = []
    changed: list[str] = []

    # mcpServers: Cardinal's entries, without the marker Gemini rejects.
    owned_servers: dict = {}
    servers = settings.get("mcpServers")
    if isinstance(servers, dict):
        for name in MANAGED_SERVERS:
            entry = servers.get(name)
            if owns_server(name, entry, prior_servers):
                entry.pop("cardinalManaged", None)
                owned_servers[name] = server_fingerprint(name, entry)
    if include_hooks:
        servers = settings.get("mcpServers") if isinstance(settings.get("mcpServers"), dict) else {}
        if mcp_url and mcp_key:
            servers[MCP_SERVER_NAME] = {"url": mcp_url, "headers": {"X-CardinalHQ-API-Key": mcp_key}}
            owned_servers[MCP_SERVER_NAME] = server_fingerprint(MCP_SERVER_NAME, servers[MCP_SERVER_NAME])
            current = servers.get(BEHAVIOR_SERVER_NAME)
            if not isinstance(current, dict) or owns_server(BEHAVIOR_SERVER_NAME, current, prior_servers):
                servers[BEHAVIOR_SERVER_NAME] = behavior_server()
                owned_servers[BEHAVIOR_SERVER_NAME] = server_fingerprint(
                    BEHAVIOR_SERVER_NAME, servers[BEHAVIOR_SERVER_NAME])
        if servers:
            settings["mcpServers"] = servers
        settings["hooks"] = set_cardinal_hook_entries(settings.get("hooks"))

    # telemetry: Cardinal's block only on request; a user's block stays.
    current = settings.get(_TELEMETRY_KEY)
    recorded = prior.get("telemetry")
    candidate = native_telemetry_block(ingest["endpoint"], gemini_cli_version()) if native and ingest else None
    ours = isinstance(current, dict) and (
        bool(current.get("cardinalManaged"))
        or (isinstance(recorded, dict) and current == recorded)
        or current == candidate
    )
    wanted = None
    if candidate is not None:
        if env_assigns(strip_env_block(read_env_file()), HEADERS_ENV):
            notes.append(f"{ENV_PATH} already sets {HEADERS_ENV}; Gemini CLI's own exporter was "
                         "left off (remove that line and re-run with --native-telemetry).")
        elif current is not None and not ours:
            notes.append(f"{SETTINGS_PATH} has a `telemetry` block Cardinal did not write; Gemini CLI's "
                         "own exporter was left off (remove the block and re-run with --native-telemetry).")
        else:
            wanted = candidate
    if wanted is not None:
        settings[_TELEMETRY_KEY] = wanted
    elif ours:
        settings.pop(_TELEMETRY_KEY)
    elif is_legacy_telemetry(current):
        settings[_TELEMETRY_KEY] = sanitized_telemetry(current)
        notes.append(f"Made the `telemetry` block in {SETTINGS_PATH} valid for Gemini CLI "
                     "(target \"otlp\" -> \"local\"; otlpHeaders removed).")

    backup_path = None
    if settings != before:
        backup_path = write_settings(before, settings)
        changed.append(str(SETTINGS_PATH))

    header = (ingest or {}).get("api_header") or "x-cardinalhq-api-key"
    if apply_env_headers(header if wanted else None, (ingest or {}).get("api_key") if wanted else None):
        changed.append(str(ENV_PATH))

    return {
        "changed": changed,
        "backup": backup_path,
        "settings_owned": {
            "telemetry": wanted,
            "mcp_servers": owned_servers,
            "env": {"path": str(ENV_PATH), "variable": HEADERS_ENV} if wanted else None,
        },
        "native_active": wanted is not None,
        "notes": notes,
    }


def repair_settings(native: bool | None = None) -> tuple[list[str], list[str]]:
    """Rewrite settings.json / ~/.gemini/.env to the valid shape without new
    credentials (a re-run while connected, or --repair): the legacy
    `telemetry` block, `cardinalManaged` keys on server entries, and the
    native exporter per `native` (None: as recorded at connect). The ingest
    key comes from cardinal-secrets.json. (paths changed, notes)"""
    state = read_state()
    if native is None:
        native = bool((state.get("native_telemetry") or {}).get("requested"))
    try:
        secrets = json.loads(SECRETS_PATH.read_text())
    except (OSError, ValueError):
        secrets = {}
    ingest = None
    if isinstance(secrets, dict) and state.get("ingest_endpoint") and secrets.get("ingest_api_key"):
        ingest = {
            "endpoint": state["ingest_endpoint"],
            "api_key": secrets["ingest_api_key"],
            "api_header": secrets.get("ingest_api_header") or "x-cardinalhq-api-key",
        }
    result = apply_settings(ingest, None, None, include_hooks=False, native=native)
    changed = list(result["changed"])
    changed += redact_legacy_backups()
    if STATE_PATH.exists():
        record = dict(settings_owned_record(state))
        new_record = {**record, **result["settings_owned"]}
        new_native = {"requested": bool(native), "enabled": result["native_active"]}
        if new_record != record or state.get("native_telemetry") != new_native:
            state["settings_owned"] = new_record
            state["native_telemetry"] = new_native
            atomic_write(STATE_PATH, json.dumps(state, indent=2) + "\n")
    elif result["settings_owned"]["mcp_servers"]:
        result["notes"].append("No ~/.gemini/cardinal.json: cardinal-disconnect --force will not "
                               "recognise the Cardinal MCP entries left in settings.json.")
    return changed, result["notes"]


def write_secrets(bundle: dict) -> None:
    ingest = bundle.get("ingest") or {}
    mcp = bundle.get("mcp") or {}
    payload = {
        "schema_version": 1,
        "ingest_api_key": ingest.get("api_key"),
        "ingest_api_header": ingest.get("api_header") or "x-cardinalhq-api-key",
        "mcp_api_key": mcp.get("api_key"),
        "written_at": datetime.now(timezone.utc).isoformat(),
    }
    # The control-plane token acts as the user across their orgs; it lives only
    # here (0600). migrate-from-grafana reads act_api_key / act_endpoint.
    act = deviceflow.act_credential(bundle)
    if act:
        payload["act_api_key"] = act["api_key"]
        payload["act_endpoint"] = act.get("endpoint")
    atomic_write_secret(SECRETS_PATH, json.dumps(payload, indent=2) + "\n")


def write_state(bundle: dict, host: str, deployment_env: str,
                telemetry_only: bool, no_extension: bool,
                settings_result: dict | None = None, native: bool = False) -> None:
    org = bundle.get("org", {})
    user = bundle.get("user", {})
    mcp = bundle.get("mcp") or {}
    ingest = bundle.get("ingest") or {}
    mode = (
        "telemetry-only" if telemetry_only or not mcp
        else "mcp-only" if not ingest
        else "telemetry-and-mcp"
    )
    state = {
        "schema_version": 1,
        "host": host,
        "mode": mode,
        "install_shape": "settings" if no_extension else "extension",
        "org_id": org.get("id"),
        "org_slug": org.get("slug"),
        "user_email": user.get("email"),
        "deployment_environment": deployment_env,
        "plugin_version": PLUGIN_VERSION,
        "written_at": datetime.now(timezone.utc).isoformat(),
        "settings_path": str(SETTINGS_PATH),
        "extension_dir": str(EXTENSION_INSTALL_DIR) if not no_extension else None,
        "secrets_path": str(SECRETS_PATH),
        "telemetry": {"enabled": bool(ingest)},
        # Gemini CLI's own OTLP exporter (--native-telemetry): requested,
        # and whether its settings.json block + .env header were written.
        "native_telemetry": {
            "requested": bool(native),
            "enabled": bool((settings_result or {}).get("native_active")),
        },
        # What Cardinal wrote into settings.json / ~/.gemini/.env (Gemini
        # rejects marker keys there), so cardinal-disconnect removes exactly that.
        "settings_owned": (settings_result or {}).get("settings_owned")
        or {"telemetry": None, "mcp_servers": {}, "env": None},
    }
    reason = deviceflow.ingest_unavailable_reason(bundle)
    if reason:
        # Why the server minted no ingest key, so cardinal-status can say so.
        state["telemetry"]["unavailable_reason"] = reason
    if ingest:
        state["ingest_endpoint"] = ingest.get("endpoint")
        state["ingest_key_id"] = ingest.get("key_id")
        state["ingest_key_prefix"] = (ingest.get("api_key") or "")[:8]
    if mcp:
        state["mcp_url"] = mcp.get("url")
        state["mcp_key_id"] = mcp.get("key_id")
        state["mcp_key_prefix"] = mcp.get("key_prefix") or (mcp.get("api_key") or "")[:8]
        state["mcp_created_at"] = mcp.get("created_at")
    act = deviceflow.act_credential(bundle)
    if act:
        state["act_key_id"] = act.get("key_id")
        state["act_key_prefix"] = act.get("key_prefix")
        state["act_created_at"] = act.get("created_at")
        state["act_scopes"] = deviceflow.act_granted_scopes(act)
    limits = bundle.get("limits")
    if isinstance(limits, dict) and limits.get("status_url"):
        state["limits"] = {
            "status_url": limits["status_url"],
            "enabled": bool(limits.get("enabled", True)),
        }
    tls_state = tls.state_block(bundle, host)
    if tls_state:
        state["tls"] = tls_state
    atomic_write(STATE_PATH, json.dumps(state, indent=2) + "\n")


def revoke_dropped_act_token(host: str, act: dict | None) -> None:
    """A re-connect whose bundle carries no control-plane token revokes the
    prior one server-side before its key_id leaves the state file — otherwise
    a live "acts as you" token orbits un-revokable."""
    if act:
        return
    def read(path: Path) -> dict:
        try:
            data = json.loads(path.read_text())
        except (OSError, ValueError):
            return {}
        return data if isinstance(data, dict) else {}

    prior = read(STATE_PATH)
    key_id = prior.get("act_key_id")
    if not key_id:
        return
    # Without the plaintext the server answers 403 and we point at the UI.
    plaintext = read(SECRETS_PATH).get("act_api_key")
    ok, msg = deviceflow.revoke_maestro_key(host, key_id, plaintext)
    prefix = prior.get("act_key_prefix") or key_id
    if ok:
        print(f"Revoked prior control-plane token {prefix} server-side ({msg})")
    else:
        print(f"Could not revoke prior control-plane token {prefix} ({msg}).")
        print(f"Visit {host}/settings/api-keys to revoke it manually.")


def continue_after_grant(args: argparse.Namespace, grant: dict) -> int:
    expires_in = int(grant.get("expires_in") or deviceflow.DEFAULT_POLL_TIMEOUT_SECS)
    interval = int(grant.get("interval") or deviceflow.DEFAULT_POLL_INTERVAL_SECS)
    verification_uri = grant.get("verification_uri") or ""

    print()
    print("Open this URL in your browser to approve Cardinal for Gemini CLI:")
    print(f"  {verification_uri}")
    print()
    print(f"Waiting up to {expires_in // 60} minute(s) for browser approval...")

    bundle = deviceflow.poll_device_token(
        args.host, grant["device_code"], CLIENT_ID, interval, expires_in
    )
    org = bundle.get("org", {})
    user = bundle.get("user", {})
    ingest = bundle.get("ingest")
    mcp = bundle.get("mcp")
    act = deviceflow.act_credential(bundle)

    # The bundle's endpoints may sit on another hostname than the app host:
    # the same trust check, before anything probes them.
    try:
        tls.ensure_hosts_trusted(tls.connection_urls(bundle, args.host), trust=getattr(args, "trust_cert", []),
                                 command=connect_command(args))
    except tls.CertificateError as exc:
        print(str(exc), file=sys.stderr)
        return tls.EXIT_UNTRUSTED_CERT

    # Set when the server granted the other scopes but minted no ingest key
    # (org has no Lakerunner, or no ingest endpoint configured). Connect goes
    # on without telemetry as long as there is an MCP credential to wire.
    ingest_reason = deviceflow.ingest_unavailable_reason(bundle)

    if not ingest and not mcp:
        sys.exit(
            "Cardinal did not return an ingest credential "
            f"({deviceflow.ingest_unavailable_note(ingest_reason or 'unknown', mcp_connected=False)}). "
            "Nothing to connect."
        )
    if not args.telemetry_only and not mcp:
        sys.exit("Cardinal did not return an MCP credential. Check the requested scopes.")

    deployment_env = args.deployment_env or deviceflow.derive_deployment_env(args.host)
    # --native-telemetry / --no-native-telemetry; neither keeps the prior choice.
    native = getattr(args, "native_telemetry", None)
    if native is None:
        native = bool((read_state().get("native_telemetry") or {}).get("requested"))

    if args.dry_run:
        print(json.dumps({
            "org": org,
            "user": user,
            "deployment_env": deployment_env,
            "would_write": {
                "settings": str(SETTINGS_PATH),
                "extension_dir": str(EXTENSION_INSTALL_DIR) if not args.no_extension else None,
                "state": str(STATE_PATH),
                "secrets": str(SECRETS_PATH),
                "ingest_endpoint": (ingest or {}).get("endpoint"),
                "ingest_unavailable_reason": ingest_reason,
                "mcp_url": (mcp or {}).get("url"),
                "native_telemetry": native,
                "act_scopes": deviceflow.act_granted_scopes(act) if act else None,
            },
        }, indent=2))
        return 0

    # No ingest credential: nothing to probe, and no telemetry config to
    # write — skip rather than abort so the MCP config still gets written.
    if ingest:
        ok, msg = deviceflow.verify_ingest_reachable(ingest)
        if not ok:
            sys.exit(f"Ingest reachability failed: {msg}")
        print(f"Ingest endpoint reachable ({msg})")

    if mcp:
        ok, msg = deviceflow.verify_mcp_reachable(mcp.get("url"), mcp.get("api_key"))
        if not ok:
            sys.exit(f"MCP reachability failed: {msg}")
        print(f"MCP endpoint reachable ({msg})")

    if not HOOK_SCRIPT.exists():
        sys.exit(f"Telemetry hook script is missing: {HOOK_SCRIPT}")

    mcp_url = mcp.get("url") if mcp else None
    mcp_key = mcp.get("api_key") if mcp else None

    if not args.no_extension:
        install_extension_bundle(mcp_url, mcp_key)
        print(f"Installed Cardinal extension to {EXTENSION_INSTALL_DIR}")

    settings_result = apply_settings(
        ingest, mcp_url, mcp_key, include_hooks=args.no_extension, native=native
    )
    for path in settings_result["changed"]:
        print(f"Wrote Cardinal config to {path}")
    if settings_result["backup"]:
        print(f"Settings backup: {settings_result['backup']}")
    for note in settings_result["notes"]:
        print(f"WARN {note}")

    revoke_dropped_act_token(args.host, act)
    write_secrets(bundle)
    print(f"Wrote Cardinal local secrets to {SECRETS_PATH}")

    write_state(bundle, args.host, deployment_env, args.telemetry_only, args.no_extension,
                settings_result, native)
    print(f"Wrote Cardinal state to {STATE_PATH}")

    print()
    print(f"Connected as {user.get('email') or 'unknown'} ({org.get('slug') or org.get('id')})")
    if ingest:
        print(f"Telemetry endpoint: {ingest['endpoint']}")
        if settings_result["native_active"]:
            print(f"Gemini CLI's own OTLP exporter: on (API key header in {ENV_PATH}; "
                  "a project .env or an untrusted folder hides it, see README)")
        else:
            print("Gemini CLI's own OTLP exporter: off (Cardinal's hooks send Cardinal's events; "
                  "--native-telemetry turns it on)")
    else:
        print(f"WARN {deviceflow.ingest_unavailable_note(ingest_reason or 'unknown', mcp_connected=bool(mcp))}")
        print("     Re-run cardinal-connect --rotate once telemetry ingest is available.")
    if mcp:
        print(f"MCP endpoint: {mcp['url']}")
    if act:
        granted = deviceflow.act_granted_scopes(act)
        print(f"Actions: enabled ({', '.join(granted)}, key {act.get('key_prefix')})")
        missing = [s for s in getattr(args, "extra_scopes", []) if s not in granted]
        if missing:
            print(f"WARN Not granted: {', '.join(missing)} — the server didn't grant them "
                  "(your org role, or this Cardinal server doesn't offer them yet).")
    elif getattr(args, "act_requested", False):
        print("WARN Cardinal returned no control-plane token: skills that write dashboards or")
        print("     alert rules as you (migrate-from-grafana) need a login token or API key.")
    for line in tls.runtime_lines("gemini", bundle, args.host):
        print(line)
    print()
    print("Restart Gemini CLI so it reloads settings and (re)loads the Cardinal extension,")
    print("then run cardinal-status.")
    return 0


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        prog="cardinal-connect",
        description="Connect Gemini CLI to Cardinal's unified MCP endpoint and telemetry.",
    )
    parser.add_argument("--host", default="https://app.cardinalhq.io",
                        help="Cardinal app host (default: https://app.cardinalhq.io)")
    parser.add_argument("--rotate", action="store_true",
                        help="Proceed even if Cardinal state already exists and mint a fresh key.")
    parser.add_argument("--telemetry-only", action="store_true",
                        help="Only configure Cardinal telemetry; skip the MCP credential.")
    parser.add_argument("--no-extension", action="store_true",
                        help="Skip the ~/.gemini/extensions/cardinal/ bundle and merge "
                             "mcpServers + hooks directly into ~/.gemini/settings.json.")
    parser.add_argument("--deployment-env", default=None,
                        help="Override deployment.environment (default derived from --host).")
    parser.add_argument("--dry-run", action="store_true",
                        help="Run the device-code flow and print what would be written.")
    parser.add_argument(
        "--native-telemetry", action=argparse.BooleanOptionalAction, default=None,
        help="Also turn on Gemini CLI's own OTLP exporter: a `telemetry` block in "
             "~/.gemini/settings.json and the ingest key header in ~/.gemini/.env "
             "(Gemini reads OTLP headers only from the environment). Gemini loads one .env "
             "per start, so a project .env or an untrusted folder hides the header there. "
             "Off by default; omitted keeps the prior choice.")
    parser.add_argument(
        "--repair", action="store_true",
        help="Rewrite Cardinal's settings.json / extension entries to what this plugin "
             "writes, without the device flow or new keys. Fixes the invalid `telemetry` "
             "block plugin 0.22.1 and earlier wrote (Gemini CLI then refuses to start).")
    parser.add_argument(
        "scopes", nargs="*", metavar="SCOPE",
        help="Extra scopes for the control-plane token: "
             f"{', '.join(deviceflow.ACT_EXTRA_SCOPES)} (space- or comma-separated). "
             "All are requested by default; naming them only matters with "
             "--minimal-scopes. They let agents create/edit dashboards and alert "
             "rules, and query telemetry (read-only), as you — within your org role.",
    )
    parser.add_argument(
        "--minimal-scopes", action="store_true",
        help="Don't request the control-plane token and its extra scopes by default — "
             "only those named as positional args (none: no token). Skills that write "
             "dashboards or alert rules as you (migrate-from-grafana) then need a "
             "reconnect or an org API key.",
    )
    parser.add_argument(
        "--trust-cert", action="append", default=[], metavar="SHA256",
        help="Trust the certificate with this SHA-256 fingerprint for the host "
             "that presents it (a self-hosted Cardinal behind a self-signed "
             "certificate). Connect shows the fingerprint and asks only when "
             "the machine does not already trust the host; repeatable.",
    )
    args = parser.parse_args()
    try:
        args.named_scopes = deviceflow.parse_act_scopes(args.scopes)
    except ValueError as exc:
        parser.error(str(exc))
    return args


def print_repairs(repaired: list[str], notes: list[str]) -> None:
    for note in notes:
        print(f"WARN {note}")
    if repaired:
        print("Repaired the Cardinal configuration (credentials unchanged):")
        for path in dict.fromkeys(repaired):
            print(f"  {path}")


def connect_command(args: argparse.Namespace) -> str:
    """How to re-run this connect (shown when a certificate needs --trust-cert)."""
    parts = ["cardinal-connect"]
    if args.host != "https://app.cardinalhq.io":
        parts += ["--host", args.host]
    for flag in ("rotate", "telemetry_only", "minimal_scopes"):
        if getattr(args, flag, False):
            parts.append("--" + flag.replace("_", "-"))
    return " ".join(parts)


def main() -> int:
    args = parse_args()

    if args.repair:
        # Works without a connection too: a settings.json left broken by an
        # earlier plugin version must not keep Gemini CLI from starting.
        repaired = repair_hook_registration() if STATE_PATH.exists() else []
        changed, notes = repair_settings(args.native_telemetry)
        print_repairs(repaired + changed, notes)
        if not (repaired or changed):
            print("Nothing to repair: Cardinal's Gemini CLI configuration is current.")
        else:
            print("Restart Gemini CLI so it reloads settings, hooks and skills.")
        return 0

    if STATE_PATH.exists() and not args.rotate:
        try:
            prior = json.loads(STATE_PATH.read_text())
        except Exception:
            prior = {}
        user = prior.get("user_email") or "this account"
        # Re-running on an existing connection refreshes the hook
        # registration in place (fixes installs from older plugin versions).
        repaired = repair_hook_registration()
        changed, notes = repair_settings(args.native_telemetry)
        print_repairs(repaired + changed, notes)
        if repaired or changed:
            print(f"Cardinal is already connected as {user}. Restart Gemini CLI so it reloads "
                  "settings, hooks and skills.")
            return 0
        sys.stderr.write(
            f"Cardinal is already connected as {user}. "
            "Re-run with --rotate to overwrite.\n"
        )
        return 2

    scopes = ["ingest:write"]
    if not args.telemetry_only:
        scopes.append("mcp:invoke")
    # The control-plane token (maestro:act) and its extra scopes, so skills can
    # write dashboards / alert rules and query telemetry as the user. Requested
    # by default; scopes the user named are required, the rest are dropped by a
    # Cardinal server that doesn't offer them yet.
    named = args.named_scopes
    extra = deviceflow.default_act_scopes(named, args.minimal_scopes)
    act_scopes = ["maestro:act", *extra] if extra else []
    required = scopes + (["maestro:act", *named] if named else [])
    print(f"Requesting Cardinal consent for scopes: {', '.join(scopes + act_scopes)}")
    if act_scopes:
        print("WARN maestro:act grants a long-lived token that acts as you across your orgs.")
        print(f"     It is stored 0600 in {SECRETS_PATH}; cardinal-disconnect revokes it.")
        for line in deviceflow.act_scope_warnings(extra):
            print(line)
    # A host whose certificate this machine does not trust (self-hosted,
    # self-signed) is shown and pinned with the user's consent first; a
    # trusted host passes silently. docs/specs/tls-trust.md.
    try:
        tls.ensure_trusted(args.host, trust=getattr(args, "trust_cert", []), command=connect_command(args))
    except tls.CertificateError as exc:
        print(str(exc), file=sys.stderr)
        return tls.EXIT_UNTRUSTED_CERT
    try:
        grant, requested = deviceflow.start_device_code_with_fallback(
            args.host, required, act_scopes, CLIENT_ID)
        args.act_requested = "maestro:act" in requested
        args.extra_scopes = [s for s in extra if s in requested]
        write_pending(grant)
        try:
            return continue_after_grant(args, grant)
        finally:
            clear_pending()
    except deviceflow.DeviceFlowError as exc:
        sys.exit(str(exc))


if __name__ == "__main__":
    sys.exit(main())
