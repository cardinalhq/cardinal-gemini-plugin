{
  "_comment": "Extension-scoped hook registrations. Gemini CLI's extension loader requires the event map under a top-level `hooks` key, and `timeout` is in milliseconds. AfterAgent is deliberately not registered: Gemini fires it once per main-agent turn, not per subagent. The `command` string is rewritten by cardinal-connect at install time to reference the plugin's absolute path.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 __HOOK_SCRIPT__ --event SessionStart # cardinal-gemini-plugin",
            "timeout": 10000
          }
        ]
      }
    ],
    "BeforeAgent": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 __HOOK_SCRIPT__ --event BeforeAgent # cardinal-gemini-plugin",
            "timeout": 10000
          }
        ]
      }
    ],
    "AfterModel": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 __HOOK_SCRIPT__ --event AfterModel # cardinal-gemini-plugin",
            "timeout": 10000
          }
        ]
      }
    ],
    "AfterTool": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 __HOOK_SCRIPT__ --event AfterTool # cardinal-gemini-plugin",
            "timeout": 10000
          }
        ]
      }
    ],
    "PreCompress": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 __HOOK_SCRIPT__ --event PreCompress # cardinal-gemini-plugin",
            "timeout": 10000
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 __HOOK_SCRIPT__ --event SessionEnd # cardinal-gemini-plugin",
            "timeout": 10000
          }
        ]
      }
    ]
  }
}
